# --- Auth (simple shared password) ---
# Leave APP_PASSWORD empty to disable the login gate (local dev).
APP_PASSWORD=
# Secret used to sign the session cookie. Any long random string.
AUTH_SECRET=

# --- Storage: Upstash Redis (Vercel "Upstash" / "KV" marketplace integration) ---
# Set automatically by the Vercel integration. Locally, leave blank to use a
# JSON file fallback (api/_lib/data/.local-store.json).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Snapshot refresh ---
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" automatically when set.
CRON_SECRET=
# Optional: allow manual refresh via /api/refresh?key=...
REFRESH_KEY=
