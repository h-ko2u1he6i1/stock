# --- Auth ---
# Owner password: full access to your real portfolio.
# Leave empty to disable the login gate entirely (local dev).
APP_PASSWORD=
# Viewer password (optional): access to a SEPARATE shared demo portfolio
# (seeded from api/_lib/data/positions.viewer-seed.json). Viewers can add/edit/
# delete freely, but only within this demo dataset — they never see or touch
# your real holdings. Share this password with reviewers.
VIEWER_PASSWORD=
# Secret used to sign the session cookie. Any long random string.
AUTH_SECRET=

# --- Storage: Upstash Redis (Vercel "Upstash" / "KV" marketplace integration) ---
# Set automatically by the Vercel integration. Locally, leave blank to use a
# JSON file fallback (api/_lib/data/.local-store.json).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Snapshot refresh ---
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" automatically when set.
CRON_SECRET=
# Optional: allow manual refresh via /api/refresh?key=...
REFRESH_KEY=
