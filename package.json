{
  "name": "stock-portfolio",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "workspaces": [
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"tsx watch dev-server.ts\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "typecheck": "tsc -p tsconfig.json && tsc -b client",
    "refresh": "tsx --eval \"import('./api/_lib/snapshot.js').then(m=>m.refreshSnapshot('owner')).then(s=>console.log(s.fetchedAt))\"",
    "import:positions": "node scripts/import-positions.mjs"
  },
  "dependencies": {
    "@upstash/redis": "^1.34.3",
    "@vercel/functions": "^2.0.0",
    "jose": "^5.9.6",
    "p-limit": "^6.1.0",
    "yahoo-finance2": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.11",
    "@vercel/node": "^5.1.0",
    "concurrently": "^9.1.0",
    "express": "^4.21.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
